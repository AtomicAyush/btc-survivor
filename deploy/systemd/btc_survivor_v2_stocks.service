# BTC Survivor version 2, the stock process of PLAN_V2 sections 14.2 and 14.5, for the move to a Raspberry Pi after
# the window. It runs both stock runs, S1 prices and S2 news, on the one Finnhub websocket the key allows, and no real
# order is ever placed. Nothing installs this file. It is installed only with the owner's approval, together with
# btc_survivor_v2_news.service, because the two share news.db, by the steps in docs/v2_operations.md.
# Replace CHANGE_ME with the user that owns the project folder before installing.
# Enable systemd-time-wait-sync.service too, or time-sync.target does not wait for a real clock.

[Unit]
Description=BTC Survivor version 2 stock process
Wants=network-online.target btc_survivor_v2_news.service
After=network-online.target time-sync.target btc_survivor_v2_news.service

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/btc_survivor_v2
Environment=PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1
UMask=0077
ExecStart=/home/CHANGE_ME/btc_survivor_v2/.venv-v2/bin/btc_survivor_v2 stocks configs/v2/s1_prices.toml configs/v2/s2_news.toml
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
